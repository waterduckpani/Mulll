<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<!-- TRUEPREDICATE would put Mull in every share sheet on the phone,
			     including ones it can do nothing with. Only offer Mull for the
			     three things the inbox knows how to read. -->
			<key>NSExtensionActivationRule</key>
			<dict>
				<!-- A three-hour browsing session ends with a camera roll full
				     of screenshots. Selecting twenty of them and sorting the
				     lot in one pass is the whole point of the share sheet. -->
				<key>NSExtensionActivationSupportsImageWithMaxCount</key>
				<integer>20</integer>
				<key>NSExtensionActivationSupportsWebURLWithMaxCount</key>
				<integer>1</integer>
				<key>NSExtensionActivationSupportsText</key>
				<true/>
			</dict>
		</dict>
		<!-- No storyboard: the triage UI is built in code so it can size itself
		     to however many screenshots arrived. -->
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).ShareViewController</string>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.share-services</string>
	</dict>
</dict>
</plist>
