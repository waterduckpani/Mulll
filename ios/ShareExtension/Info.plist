<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<!-- Images only. Mull reads a UPI receipt off a screenshot and
			     settles the debt it pays off; a shared link or a line of text
			     has nowhere to go, and appearing in that share sheet only to
			     do nothing is worse than not appearing. -->
			<key>NSExtensionActivationRule</key>
			<dict>
				<!-- Several at once: a trip ends with a run of payments to
				     everybody, and sending the lot in one pass beats eight
				     trips through the share sheet. -->
				<key>NSExtensionActivationSupportsImageWithMaxCount</key>
				<integer>20</integer>
			</dict>
		</dict>
		<!-- No storyboard: the confirmation list is built in code so it can
		     size itself to however many screenshots arrived. -->
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).ShareViewController</string>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.share-services</string>
	</dict>
</dict>
</plist>
